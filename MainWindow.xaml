<Window x:Class="PainelOtimizacao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel de Otimização" Height="350" Width="500"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Grid.Row="0" Text="Painel de Otimização do Windows" 
                   Foreground="White" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Conteúdo Principal -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Botão Mestre -->
            <Button Content="Otimização Completa (1-Clique)" 
                    Click="BtnOtimizacaoCompleta_Click" 
                    Height="45" Width="280" 
                    Background="#007ACC" Foreground="White" 
                    FontSize="14" FontWeight="Bold" Cursor="Hand"/>

            <TextBlock x:Name="TxtStatus" Text="Aguardando ação..." 
                       Foreground="#71717A" FontSize="12" 
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Rodapé -->
        <TextBlock Grid.Row="2" Text="v1.0.0 - Módulo C# backend pronto" 
                   Foreground="#52525B" FontSize="11" 
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>