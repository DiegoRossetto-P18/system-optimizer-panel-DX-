<Window x:Class="PainelOtimizacaoDx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel de otimização DX"
        Width="960"
        Height="610"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6BF5DF" />
        <Brush x:Key="BorderAccentBrush">#4D76C893</Brush>
        <Brush x:Key="SubtleFrameBrush">#2E76C893</Brush>
        <Brush x:Key="TextAccentBrush">#6BF5DF</Brush>
        <Brush x:Key="LogoAccentBrush">#78F5E3</Brush>

        <SolidColorBrush x:Key="CardBrush" Color="#D9101116" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#EB171922" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TabBarBrush" Color="#C807080B" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D2CEE0" />
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#2C2A3B" />
        <SolidColorBrush x:Key="ToggleThumbBrush" Color="#A39EB5" />
        <SolidColorBrush x:Key="PopupBrush" Color="#F20F1016" />

        <!-- Botões Minimizar / Fechar -->
        <Style x:Key="ChromeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D0D0D8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo das Abas -->
        <Style x:Key="TabButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource TabBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="13"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#4412141D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Pílula -->
        <Style x:Key="SwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="{DynamicResource ToggleOffBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource ToggleThumbBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#0E1116" />
                                <Setter TargetName="Thumb" Property="Margin" Value="25,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card das opções -->
        <Style x:Key="OptimizationCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Padding" Value="16,0,12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão (i) circular -->
        <Style x:Key="InfoButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B8B4C6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Width="18"
                                Height="18"
                                CornerRadius="9"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="1.3"
                                Background="Transparent">
                            <TextBlock Text="i"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowShell"
            Background="#07080B"
            BorderBrush="#242630"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- IMAGEM DE FUNDO -->
            <Image x:Name="BackgroundImage"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False" />

            <!-- ESTRUTURA PRINCIPAL -->
            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. TOPO -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="42" Height="28" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Rectangle x:Name="LogoMaskRect"
                                       Fill="{DynamicResource LogoAccentBrush}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="LogoFallback"
                                       Text="DX"
                                       Foreground="{DynamicResource LogoAccentBrush}"
                                       FontFamily="Segoe UI Black"
                                       FontSize="24"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Painel de otimização"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Click="MinimizeButton_Click" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource ChromeButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 2. ABAS -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderAccentBrush}"
                        BorderThickness="1,0,1,0">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Tag="{Binding}"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              Click="TabButton_Click"
                                              Style="{StaticResource TabButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 3. MOLDURA INTERNA -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SubtleFrameBrush}"
                        BorderThickness="1,0,1,1"
                        Padding="12,16,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <!-- Otimização Completa Global (Controla todas as abas) -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                HorizontalAlignment="Right"
                                Height="36"
                                Padding="16,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Otimização Completa Global"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0" />
                                <ToggleButton x:Name="GlobalOptimizationToggle"
                                              IsChecked="False"
                                              Click="GlobalOptimizationToggle_Click"
                                              Style="{StaticResource SwitchStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Lista de Cards -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,12,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ActiveOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OptimizationCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextAccentBrush}"
                                                               FontFamily="Segoe UI Semibold"
                                                               FontSize="12.5"
                                                               VerticalAlignment="Center" />

                                                    <Button Grid.Column="1"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource InfoButtonStyle}"
                                                            MouseEnter="InfoButton_MouseEnter"
                                                            MouseLeave="InfoButton_MouseLeave"
                                                            GotKeyboardFocus="InfoButton_GotKeyboardFocus"
                                                            LostKeyboardFocus="InfoButton_LostKeyboardFocus" />

                                                    <ToggleButton Grid.Column="2"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Right"
                                                                  Style="{StaticResource SwitchStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Marcar todos"
                                        Click="MarkAllButton_Click"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontFamily="Segoe UI"
                                        FontSize="13.5"
                                        Cursor="Hand"
                                        Margin="0,4,6,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. RODAPÉ -->
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="MUDAR COR"
                                           Foreground="{DynamicResource TextAccentBrush}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <Button x:Name="ThemeSelectorButton"
                                        Click="ThemeToggleButton_Click"
                                        Width="54"
                                        Height="24"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="ThemeTrack"
                                                    Background="#26343A"
                                                    CornerRadius="12"
                                                    Padding="3">
                                                <Ellipse x:Name="ThemeThumb"
                                                         Width="18"
                                                         Height="18"
                                                         Fill="#69A39B"
                                                         HorizontalAlignment="Left" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Button Content="Executar"
                                    Click="ExecuteButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextAccentBrush}"
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="14.5"
                                    Cursor="Hand"
                                    Margin="0,0,6,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- POPUP DE INFO -->
            <Popup x:Name="InfoPopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   VerticalOffset="6"
                   HorizontalOffset="-160"
                   PopupAnimation="Fade"
                   StaysOpen="True">
                <Border x:Name="InfoPopupBorder"
                        Background="{DynamicResource PopupBrush}"
                        BorderBrush="#D0CCD8"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="12,10"
                        MouseEnter="InfoPopupBorder_MouseEnter"
                        MouseLeave="InfoPopupBorder_MouseLeave">
                    <TextBlock x:Name="InfoPopupText"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="11.5"
                               LineHeight="16" />
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>